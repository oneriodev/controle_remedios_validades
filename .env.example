# Copie para .env e preencha com valores reais. NUNCA versione o .env.

# Banco de dados
POSTGRES_USER=farmacia_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=controle_validades
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Segurança (JWT)
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=gere-uma-chave-aleatoria-longa
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# IA (Fase 4). A chave fica só no servidor, nunca no app.
GEMINI_API_KEY=